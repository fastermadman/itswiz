#!/bin/sh
# Blokerer push hvis pluginets tests fejler — så et brudt selvtjek ikke kan stå rødt uset i ugevis
# (issue #139/#160). Aktivér én gang:  git config core.hooksPath .githooks
set -e
root=$(git rev-parse --show-toplevel)
node --check "$root/plugin/main.js"
node --test "$root/plugin/test/"*.test.js
