{
  "manifest_version": 3,
  "name": "VIAstudyWiz",
  "version": "0.1.0",
  "description": "Henter lektionsplaner og materialer fra via.itslearning.com programmatisk.",
  "permissions": ["downloads", "scripting", "webRequest", "storage", "alarms"],
  "host_permissions": [
    "https://via.itslearning.com/*",
    "https://platform.itslearning.com/*",
    "https://resource.itslearning.com/*",
    "https://filerepository.itslearning.com/*",
    "https://filecache.itslearning.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VIAstudyWiz"
  }
}
